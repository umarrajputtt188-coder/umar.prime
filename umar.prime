
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Umar Prime</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #0b1220, #192b43);
      color: white;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 22px 8%;
      border-bottom: 1px solid #344052;
    }

    .logo {
      color: #e6bd72;
      font-size: 25px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    nav button {
      background: transparent;
      color: white;
      border: 1px solid #e6bd72;
      padding: 10px 17px;
      border-radius: 7px;
      cursor: pointer;
      margin-left: 8px;
    }

    nav button:hover, .primary:hover {
      opacity: 0.85;
    }

    .hero {
      text-align: center;
      padding: 85px 20px 40px;
    }

    .tag {
      color: #e6bd72;
      letter-spacing: 3px;
      font-size: 12px;
    }

    h1 {
      font-size: clamp(35px, 6vw, 60px);
      margin: 20px 0;
    }

    .hero p {
      color: #c2ccda;
      line-height: 1.7;
    }

    .primary {
      background: #e6bd72;
      color: #101827;
      border: none;
      padding: 13px 24px;
      border-radius: 7px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 25px;
    }

    .auth {
      width: min(92%, 400px);
      margin: 15px auto 60px;
      background: #ffffff;
      color: #172033;
      padding: 28px;
      border-radius: 15px;
      box-shadow: 0 15px 50px #0005;
    }

    .auth h2 {
      margin-bottom: 8px;
    }

    .auth p {
      color: #687386;
      font-size: 14px;
      margin-bottom: 20px;
    }

    .auth input {
      width: 100%;
      padding: 13px;
      margin: 8px 0;
      border: 1px solid #d4dae3;
      border-radius: 7px;
      font-size: 15px;
    }

    .auth .primary {
      width: 100%;
      margin-top: 12px;
    }

    .switch {
      margin-top: 18px;
      text-align: center;
      font-size: 14px;
    }

    .switch a {
      color: #9a6b19;
      cursor: pointer;
      font-weight: bold;
    }

    #message {
      margin-top: 12px;
      font-size: 14px;
      overflow-wrap: anywhere;
    }

    .hidden {
      display: none;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #aab5c5;
      font-size: 13px;
    }
  </style>
</head>

<body>
  <header>
    <div class="logo">👑 UMAR PRIME</div>
    <nav>
      <button onclick="showHome()">Home</button>
      <button onclick="showForm('login')">Login</button>
      <button onclick="showForm('signup')">Sign Up</button>
    </nav>
  </header>

  <section class="hero" id="home">
    <div class="tag">WELCOME TO UMAR PRIME</div>
    <h1>A Better Digital Experience</h1>
    <p>Create your account and join the Umar Prime community.</p>
    <button class="primary" onclick="showForm('signup')">
      Get Started
    </button>
  </section>

  <section class="auth hidden" id="auth">
    <h2 id="formTitle">Create Account</h2>
    <p id="formSubtitle">Join Umar Prime today.</p>

    <form id="accountForm">
      <input id="name" type="text"
        placeholder="Full Name" autocomplete="name"
        required>

      <input id="email" type="email"
        placeholder="Email Address" autocomplete="email"
        required>

      <input id="password" type="password"
        placeholder="Password" autocomplete="new-password"
        minlength="8" required>

      <button class="primary" type="submit" id="submitBtn">
        Create Account
      </button>
    </form>

    <div class="switch" id="switchText">
      Already registered?
      <a onclick="showForm('login')">Login</a>
    </div>

    <div id="message" role="status"></div>
  </section>

  <section class="auth hidden" id="dashboard">
    <h2 id="welcome"></h2>
    <p>You are viewing your Umar Prime dashboard.</p>
    <button class="primary" onclick="logout()">Logout</button>
  </section>

  <footer>
    © 2026 Umar Prime. All rights reserved.
  </footer>

  <script>
    let currentMode = "signup";

    function showHome() {
      document.getElementById("home").classList.remove("hidden");
      document.getElementById("auth").classList.add("hidden");
      document.getElementById("dashboard").classList.add("hidden");
    }

    function showForm(mode) {
      currentMode = mode;

      document.getElementById("home").classList.add("hidden");
      document.getElementById("dashboard").classList.add("hidden");
      document.getElementById("auth").classList.remove("hidden");

      const isSignup = mode === "signup";
      document.getElementById("formTitle").textContent =
        isSignup ? "Create Account" : "Welcome Back";
      document.getElementById("formSubtitle").textContent =
        isSignup ? "Join Umar Prime today." : "Login to your account.";
      document.getElementById("name").classList.toggle("hidden", !isSignup);
      document.getElementById("name").required = isSignup;
      document.getElementById("password").autocomplete =
        isSignup ? "new-password" : "current-password";
      document.getElementById("submitBtn").textContent =
        isSignup ? "Create Account" : "Login";
      document.getElementById("switchText").innerHTML = isSignup
        ? 'Already registered? <a onclick="showForm(\\'login\\')">Login</a>'
        : 'New to Umar Prime? <a onclick="showForm(\\'signup\\')">Sign Up</a>';

      document.getElementById("message").textContent = "";
      document.getElementById("accountForm").reset();
    }

    document.getElementById("accountForm").addEventListener(
      "submit", function(event) {
        event.preventDefault();

        document.getElementById("message").textContent =
          " only: Connect a secure backend to enable accounts.";
      }
    );

    function logout() {
      showHome();
    }
  </script>
</body>
</html>
